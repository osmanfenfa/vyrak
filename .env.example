# Copy to .env and fill in. Never commit .env.

# development | test | production
ZELVRYN_ENV=development

# ── Auth ──────────────────────────────────────────────────────────────────
# Required in production: random, 32+ characters (e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`)
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
# Optional: enforce issuer / audience claims from your identity provider
JWT_ISSUER=
JWT_AUDIENCE=

# Your platform-operator account (you): created at startup if it doesn't exist.
# Sign in with it, then onboard customers from the Customers tab.
# Use a strong password (10+ characters) and change it after first sign-in.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Platform admin

# Public URL of the dashboard, used to build invite and password-reset links
DASHBOARD_URL=http://localhost:5173
# How long a sign-in lasts
ACCOUNT_SESSION_HOURS=8

# Test-only shortcut: accept "role:subject" as a token. Never enable outside tests;
# it is ignored when ZELVRYN_ENV=production.
AUTH_ALLOW_PLAINTEXT_TOKENS=false

# ── Infrastructure ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=
CORS_ORIGINS=http://localhost:5173
# Only set true behind a reverse proxy you control (X-Forwarded-For is spoofable)
TRUST_PROXY_HEADERS=false
RATE_LIMIT_PER_MINUTE=1200
API_WORKERS=4

# ── Behaviour ─────────────────────────────────────────────────────────────
# Global default; each tenant can override via PATCH /tenant/settings
SHADOW_MODE_ENABLED=false
MODEL_PATH=models
